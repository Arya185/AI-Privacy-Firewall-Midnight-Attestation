// Adapted from Midnight's official Hello World tutorial pattern
// (docs.midnight.network/getting-started/hello-world). Verified to compile
// with the Compact toolchain 0.31.1 (language 0.23.0, runtime 0.16.0):
//   compact compile midnight/policy_attestation.compact <out-dir>
// Not deployed to any network.

pragma language_version 0.23;

import CompactStandardLibrary;

// Public, on-chain record: has this exact policy decision been attested?
// The key is SecurityDecision.decision_hash() from midnight_bridge.py:
// SHA-256 over a length-framed join of exactly 5 fields
// (agent, field, decision, reason, timestamp) -- the per-decision
// commitment. This is deliberately NOT the AuditLog's AuditEntry.entry_hash,
// which is a 7-field chain hash (adds request_id + prev_hash) used only
// for off-chain tamper-evidence.
// Only the hash goes on-chain. The agent name, field name, salary
// figures, etc. never appear here.
export ledger attested: Map<Bytes<32>, Boolean>;

// Called once per policy decision. `decisionHash` is private input by
// default; disclose() marks it safe to store publicly, matching the
// "only the commitment is public, not the underlying data" pattern
// from Midnight's own docs.
export circuit recordAttestation(decisionHash: Bytes<32>): [] {
  attested.insert(disclose(decisionHash), true);
}

// Read-only check that a specific decision hash was, in fact, recorded.
export circuit isAttested(decisionHash: Bytes<32>): Boolean {
  return attested.member(disclose(decisionHash));
}
