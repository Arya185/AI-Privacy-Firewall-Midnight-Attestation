{
  "name": "midnight-side",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "compact compile contract/commit.compact build/commit",
    "compile:policy": "compact compile ../../privacy_firewall/midnight/policy_attestation.compact build/policy_attestation",
    "simulate": "tsx scripts/simulate_contract.ts",
    "generate-wallet": "tsx scripts/generate_wallet.ts",
    "sync-wallet": "tsx scripts/sync_wallet.ts",
    "register-dust": "tsx scripts/register_dust.ts",
    "estimate-deploy-fee": "tsx scripts/estimate_deploy_fee.ts",
    "deploy": "tsx scripts/deploy_contract.ts",
    "commit": "tsx scripts/commit_to_chain.ts",
    "pipeline": "tsx scripts/run_pipeline.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.1.0",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.0.1",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "3.1.0"
